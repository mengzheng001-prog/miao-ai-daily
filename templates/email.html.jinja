{#- 邮件版：短通知 + 大按钮 → 点击跳转 GitHub Pages 完整网页 -#}
<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"></head>
<body style="margin:0;padding:0;background:#eef2f7;font-family:-apple-system,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;color:#1a2433;">
<div style="max-width:600px;margin:0 auto;padding:18px;">

  <!-- 顶部标题 + 大 CTA -->
  <div style="background:#13315c;border-radius:14px;padding:26px 20px;text-align:center;color:#fff;">
    <div style="font-size:24px;font-weight:800;">🐱 喵仔仔 AI 日报</div>
    <div style="margin-top:6px;color:#bcd2f0;font-size:14px;">{{ date_cn }}</div>
    <div style="margin-top:3px;color:#7fa8d6;font-size:12px;">{{ generated_at }}</div>
    <div style="margin-top:20px;">
      <a href="{{ report_url }}" style="display:inline-block;background:#06b6d4;color:#fff;text-decoration:none;font-size:17px;font-weight:700;padding:13px 32px;border-radius:8px;box-shadow:0 4px 14px rgba(6,182,212,0.45);">📰 打开今日完整日报 →</a>
    </div>
    <div style="margin-top:10px;color:#7fa8d6;font-size:11px;">完整卡片版 · hover 辉光 · 可点跳原文</div>
  </div>

  <!-- 数据概览 -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:14px;border-collapse:separate;border-spacing:8px;">
    <tr>
      {% for n, l in [(stats.sources,'抓取来源'),(stats.raw,'原始资讯'),(stats.selected,'入选资讯'),(stats.keywords,'今日关键词')] %}
      <td width="25%" style="background:#fff;border:1px solid #e3e9f2;border-radius:12px;padding:12px 4px;text-align:center;">
        <div style="font-size:24px;font-weight:800;color:#0e7490;">{{ n }}</div>
        <div style="font-size:12px;color:#5b6b82;margin-top:2px;">{{ l }}</div>
      </td>
      {% endfor %}
    </tr>
  </table>

  <!-- Top3 预览（让你扫一眼今天有啥） -->
  <div style="font-size:17px;font-weight:800;margin:24px 0 10px;color:#1e40af;border-left:4px solid #06b6d4;padding-left:9px;">今日最值得关注</div>
  {% for it in top3 %}
  <div style="background:#fff;border:1px solid #e3e9f2;border-left:4px solid #06b6d4;border-radius:12px;padding:13px 15px;margin-bottom:10px;box-shadow:0 3px 12px rgba(6,182,212,0.15);">
    <div style="font-size:12px;color:#5b6b82;margin-bottom:4px;font-weight:600;">#{{ loop.index }} · 评分 {{ it.final_score }}{% for t in it.tags %} · {{ t }}{% endfor %}</div>
    <a href="{{ it.url }}" style="font-size:15px;font-weight:700;color:#1e40af;text-decoration:underline;">{{ it.title }}</a>
    {% if it.why_zh %}<div style="margin-top:6px;font-size:13px;color:#33415a;">💡 {{ it.why_zh }}</div>{% endif %}
  </div>
  {% endfor %}

  <!-- 底部再来一个 CTA，方便扫完直接点 -->
  <div style="text-align:center;margin:26px 0 12px;">
    <a href="{{ report_url }}" style="display:inline-block;background:#1e40af;color:#fff;text-decoration:none;font-size:15px;font-weight:700;padding:12px 26px;border-radius:8px;box-shadow:0 3px 10px rgba(30,64,175,0.3);">查看全部 10 条 + PM 启发 →</a>
  </div>

  <div style="text-align:center;color:#5b6b82;font-size:11px;margin-top:18px;line-height:1.6;">
    每天北京时间 10:00 自动生成<br>
    <a href="{{ pages_url }}" style="color:#5b6b82;text-decoration:underline;">{{ pages_url }}</a>
  </div>
</div>
</body>
</html>
