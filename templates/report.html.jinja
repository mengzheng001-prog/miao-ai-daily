<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>喵仔仔 AI 日报 - {{ date_cn }}</title>
<style>
  :root{
    --bg:#f4f7fb; --card:#ffffff; --ink:#1a2433; --sub:#5b6b82;
    --line:#e3e9f2; --blue:#2563eb; --blue-deep:#1e40af; --cyan:#06b6d4;
    --glow:rgba(6,182,212,.28); --chip:#eef3fb;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:880px;margin:0 auto;padding:32px 20px 60px}

  /* 顶部 */
  header{text-align:center;padding:28px 0 22px;
    background:linear-gradient(135deg,#0b1f3a 0%,#13315c 60%,#0e2a4d 100%);
    border-radius:18px;color:#fff;position:relative;overflow:hidden}
  header::after{content:"";position:absolute;inset:0;
    background:radial-gradient(600px 120px at 50% -20%,var(--glow),transparent 70%)}
  header h1{font-size:30px;font-weight:800;letter-spacing:.5px;position:relative}
  header .sub{margin-top:8px;color:#bcd2f0;font-size:15px;position:relative}
  header .gen{margin-top:6px;color:#7fa8d6;font-size:13px;position:relative}

  h2{font-size:19px;margin:34px 0 14px;display:flex;align-items:center;gap:8px}
  h2::before{content:"";width:4px;height:18px;border-radius:3px;
    background:linear-gradient(var(--blue),var(--cyan))}

  /* 数据概览 */
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}
  .stat{background:var(--card);border:1px solid var(--line);border-radius:14px;
    padding:16px 12px;text-align:center}
  .stat .num{font-size:28px;font-weight:800;
    background:linear-gradient(90deg,var(--blue),var(--cyan));
    -webkit-background-clip:text;background-clip:text;color:transparent}
  .stat .lbl{font-size:12px;color:var(--sub);margin-top:4px}

  /* 卡片 */
  .card{display:block;background:var(--card);border:1px solid var(--line);
    border-radius:14px;padding:18px 18px 16px;margin-bottom:14px;
    transition:.2s ease;position:relative}
  .card:hover{transform:translateY(-2px);border-color:var(--cyan);
    box-shadow:0 8px 28px var(--glow)}
  .card .row{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
  .card h3{font-size:17px;font-weight:700;line-height:1.45}
  .meta{font-size:12.5px;color:var(--sub);margin:7px 0 9px}
  .meta .cat{display:inline-block;padding:1px 7px;border-radius:6px;
    background:var(--chip);color:var(--blue-deep);font-weight:600;margin-right:6px}
  .summary{font-size:14.5px;color:#33415a}
  .why{margin-top:10px;font-size:13.5px;color:var(--blue-deep);
    background:linear-gradient(90deg,#eef5ff,transparent);
    border-left:3px solid var(--cyan);padding:7px 10px;border-radius:0 8px 8px 0}

  /* 分数 */
  .score{flex-shrink:0;text-align:center;min-width:48px}
  .score .v{font-size:20px;font-weight:800;color:var(--blue)}
  .bar{height:4px;border-radius:3px;background:var(--line);margin-top:3px;overflow:hidden}
  .bar i{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--cyan))}

  /* 标签 */
  .tags{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;max-width:55%}
  .tag{font-size:11.5px;padding:2px 9px;border-radius:20px;
    background:var(--chip);color:var(--blue-deep);border:1px solid #dce6f7}

  /* Top3 强调 */
  .top3 .card{border-left:4px solid var(--cyan)}
  .rank{position:absolute;top:-10px;left:-10px;width:30px;height:30px;border-radius:50%;
    background:linear-gradient(135deg,var(--blue),var(--cyan));color:#fff;
    display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;
    box-shadow:0 4px 12px var(--glow)}

  /* 关键词 */
  .kw{display:flex;flex-wrap:wrap;gap:9px}
  .kw .k{padding:5px 13px;border-radius:22px;background:var(--card);
    border:1px solid var(--line);font-size:13px;font-weight:600}
  .kw .k b{color:var(--cyan);margin-left:5px}

  /* PM 启发：一条条列，每条有高亮重点 */
  .insight-list{list-style:none;counter-reset:ins;display:flex;flex-direction:column;gap:10px}
  .insight-list li{counter-increment:ins;background:var(--card);border:1px solid var(--line);
    border-left:4px solid var(--cyan);border-radius:12px;padding:13px 16px 13px 46px;position:relative}
  .insight-list li::before{content:counter(ins);position:absolute;left:12px;top:13px;
    width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--cyan));
    color:#fff;font-size:12.5px;font-weight:800;display:flex;align-items:center;justify-content:center;
    box-shadow:0 3px 9px var(--glow)}
  .insight-list .pt{display:block;font-weight:800;font-size:15.5px;margin-bottom:4px;
    background:linear-gradient(90deg,var(--blue-deep),var(--cyan));
    -webkit-background-clip:text;background-clip:text;color:transparent}
  .insight-list .dt{font-size:13.5px;color:#46546b;line-height:1.55}

  /* 来源生态 + 列表 */
  .eco,.srclist{background:var(--card);border:1px solid var(--line);
    border-radius:14px;padding:14px 18px}
  .eco div,.srclist a{display:flex;justify-content:space-between;gap:10px;
    padding:7px 0;border-bottom:1px dashed var(--line);font-size:13.5px}
  .eco div:last-child,.srclist a:last-child{border-bottom:none}
  .srclist a:hover{color:var(--blue)}
  .srclist .s{color:var(--sub);flex-shrink:0}

  footer{text-align:center;color:var(--sub);font-size:12px;margin-top:36px}
  @media(max-width:600px){.stats{grid-template-columns:repeat(2,1fr)}
    .tags{max-width:100%;justify-content:flex-start}}
</style>
</head>
<body>
<div class="wrap">

  <!-- 1-3 顶部 -->
  <header>
    <h1>🐱 喵仔仔 AI 日报</h1>
    <div class="sub">每日精选最值得关注的 AI 行业资讯 · {{ date_cn }}</div>
    <div class="gen">{{ generated_at }}（每日北京时间 10:00 自动生成）</div>
  </header>

  <!-- 4 数据概览 -->
  <div class="stats">
    <div class="stat"><div class="num">{{ stats.sources }}</div><div class="lbl">抓取来源</div></div>
    <div class="stat"><div class="num">{{ stats.raw }}</div><div class="lbl">原始资讯</div></div>
    <div class="stat"><div class="num">{{ stats.selected }}</div><div class="lbl">入选资讯</div></div>
    <div class="stat"><div class="num">{{ stats.keywords }}</div><div class="lbl">今日关键词</div></div>
  </div>

  <!-- 5 今日最值得关注 Top3 -->
  <h2>今日最值得关注</h2>
  <div class="top3">
    {% for it in top3 %}
    <a class="card" href="{{ it.url }}" target="_blank" rel="noopener">
      <span class="rank">{{ loop.index }}</span>
      <div class="row">
        <div style="flex:1">
          <h3>{{ it.title }}</h3>
        </div>
        <div class="score"><div class="v">{{ it.final_score }}</div>
          <div class="bar"><i style="width:{{ it.final_score }}%"></i></div></div>
      </div>
      <div class="meta"><span class="cat">{{ it.category }}</span>{{ it.source }} · {{ fmt_publish(it.published_at) }}</div>
      <div class="summary">{{ it.summary_zh }}</div>
      {% if it.why_zh %}<div class="why">💡 {{ it.why_zh }}</div>{% endif %}
      {% if it.tags %}<div class="tags" style="margin-top:10px;justify-content:flex-start;max-width:100%">
        {% for t in it.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>{% endif %}
    </a>
    {% endfor %}
  </div>

  <!-- 6 精选资讯卡片列表 Top10 -->
  <h2>精选资讯</h2>
  {% for it in items %}
  <a class="card" href="{{ it.url }}" target="_blank" rel="noopener">
    <div class="row">
      <div style="flex:1"><h3>{{ it.title }}</h3></div>
      <div class="tags">{% for t in it.tags %}<span class="tag">{{ t }}</span>{% endfor %}</div>
    </div>
    <div class="meta"><span class="cat">{{ it.category }}</span>{{ it.source }} · {{ fmt_publish(it.published_at) }} · 评分 {{ it.final_score }}</div>
    <div class="summary">{{ it.summary_zh }}</div>
    {% if it.why_zh %}<div class="why">💡 {{ it.why_zh }}</div>{% endif %}
  </a>
  {% endfor %}

  <!-- 7 今日关键词 -->
  <h2>今日关键词</h2>
  <div class="kw">
    {% for k in keywords %}<span class="k">{{ k.tag }}<b>{{ k.count }}</b></span>{% endfor %}
  </div>

  <!-- 8 今日 AI 产品经理启发 -->
  <h2>今日 AI 产品经理启发</h2>
  <ol class="insight-list">
    {% for p in pm_insights %}
    <li><span class="pt">{{ p.point }}</span>{% if p.detail %}<span class="dt">{{ p.detail }}</span>{% endif %}</li>
    {% endfor %}
  </ol>

  <!-- 9 资讯来源生态 -->
  <h2>资讯来源生态</h2>
  <div class="eco">
    {% for s in source_eco %}
    <div><span><span class="cat" style="background:var(--chip);padding:1px 7px;border-radius:6px;color:var(--blue-deep);font-weight:600">{{ s.category }}</span> {{ s.name }}</span><span>{{ s.count }} 条</span></div>
    {% endfor %}
  </div>

  <!-- 10 原文来源列表 -->
  <h2>原文来源列表</h2>
  <div class="srclist">
    {% for s in source_list %}
    <a href="{{ s.url }}" target="_blank" rel="noopener"><span>{{ s.title }}</span><span class="s">{{ s.source }} ↗</span></a>
    {% endfor %}
  </div>

  <footer>喵仔仔 AI 日报 · 用最少时间掌握最新 AI 行业动态</footer>
</div>
</body>
</html>
