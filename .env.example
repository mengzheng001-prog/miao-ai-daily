# 复制为 .env 并填值。.env 不要提交（已在 .gitignore）。

# ---- AI 引擎鉴权（二选一）----
# 本地已登录 Claude Code 时无需填；CI(GitHub Actions) 里必须填其一。
# 推荐：本地执行 `claude setup-token` 生成长期 OAuth Token，复用订阅额度。
CLAUDE_CODE_OAUTH_TOKEN=
# 备选：按量计费的 API Key
ANTHROPIC_API_KEY=

# ---- 邮件推送（可选）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
